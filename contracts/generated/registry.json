            "portId": {
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "title": "Portid",
              "type": "string"
            },
            "stage": {
              "maximum": 100,
              "minimum": 1,
              "title": "Stage",
              "type": "integer"
