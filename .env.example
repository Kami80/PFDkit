# Guest-only web use needs no environment configuration or backend.
# Never put secrets in NEXT_PUBLIC_* variables. Copy to ignored .env for Compose.
POSTGRES_DB=pfdkit
POSTGRES_USER=pfdkit
# Compose interpolates this into a URL: use a long random hex password (no URL delimiters).
POSTGRES_PASSWORD=replace-with-long-random-hex-password
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret-at-least-50-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local HTTP only. Use true behind public HTTPS.
DJANGO_SECURE_COOKIES=false
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Optional SMTP: use django.core.mail.backends.smtp.EmailBackend above.
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=25
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=false
DJANGO_DEFAULT_FROM_EMAIL=noreply@localhost
# Enable only behind a proxy which overwrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY=false
DJANGO_SSL_REDIRECT=false
PFDKIT_PUBLIC_ORIGIN=http://localhost:3000
PFDKIT_BIND=127.0.0.1
PFDKIT_PORT=3000
# For native operation set in the shell; Django does not load root .env automatically.
# DATABASE_URL=postgresql://pfdkit:your-password@127.0.0.1:5432/pfdkit
# PFDKIT_API_ORIGIN=http://127.0.0.1:8000
# API origin is server-only and read during Next.js build. Rebuild if changing it.
